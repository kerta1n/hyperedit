{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/react-app/main.tsx",
    "src/remotion/index.tsx",
    "scripts/server/render-worker.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.{js,ts}"],
  "ignore": [
    ".bun/**",
    "dist/**",
    "src/react-app/vite-env.d.ts"
  ],
  "ignoreDependencies": [
    "@remotion/media",
    "@remotion/transitions"
  ],
  "rules": {
    "exports": "warn",
    "types": "warn"
  }
}
